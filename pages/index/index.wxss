/* pages/index/index.wxss */
.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f7f8fa;
}

/* 搜索栏样式 */
.search-bar {
  position: relative; /* 父容器设为相对定位 */
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx 30rpx 50rpx; /* 上 右 下 左（向左增加20rpx） */
  background-color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.search-bar input {
  width: 75%;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx 0 80rpx;
  font-size: 28rpx;
  margin-left: -40rpx; /* 整体左移 */
  
}

/* 新增刷新图标样式 */
.refresh-icon {
  width: 35rpx;          /* 与搜索图标比例协调 */
  height: 35rpx;         /* 保持正方形 */
  margin-left: 30rpx;    /* 与输入框间隔 */
  opacity: 0.7;          /* 弱化视觉权重 */
  transition: opacity 0.3s;
}

input {
  position: relative;
  margin-left: 20rpx;  /* 向右移动 */
  margin-top: 0rpx;   /* 向下移动 */
}

.refresh-icon:active {
  opacity: 1;            /* 点击时高亮反馈 */
}



.placeholder-style {
  color: #999;
}

.search-icon {
  z-index: 10; /* 确保图标在输入框上方 */
  margin-right: -10rpx; /* 图标与文字间距 */
  color: #999; /* 图标颜色与占位文字一致 */
}

/* 骨架屏样式 */
.loading-container {
  padding: 30rpx;
}

.skeleton-item {
  display: flex;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx;
}

.skeleton-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #f2f2f2;
  margin-right: 24rpx;
  border-radius: 8rpx;
}

.skeleton-content {
  flex: 1;
}

.skeleton-title {
  width: 60%;
  height: 36rpx;
  background-color: #f2f2f2;
  margin-bottom: 24rpx;
  border-radius: 8rpx;
}

.skeleton-text {
  width: 90%;
  height: 28rpx;
  background-color: #f2f2f2;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

.skeleton-text.short {
  width: 70%;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 30rpx;
  text-align: center;
}

.error-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.error-text {
  color: #666;
  margin-bottom: 40rpx;
  font-size: 32rpx;
}

.retry-btn {
  width: 240rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 30rpx;
  text-align: center;
}

.empty-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: #999;
  font-size: 32rpx;
}

/* 活动列表 */
.activity-scroll {
  flex: 1;
  height: 100%;
}

.activity-list {
  padding: 20rpx;
}

.activity-card {
  display: flex;
  margin: 20rpx;
  padding: 15rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.activity-image {
  width: 240rpx;
  height: 240rpx;
  margin-top: 18rpx;
}

.activity-content {
  flex: 1;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.activity-title {
  margin-bottom: 5rpx;
  margin-left: 15rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 250rpx;
}


.activity-status {
  position: relative; /* 定位父级 */
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx; /* 控制整体宽度 */
  margin-left: 0rpx;
}


/* 背景层 */
.status-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  z-index: 1;
}

/* 文字层 */
.status-text {
  position: relative;
  z-index: 2;
  font-size: 24rpx;
  color: #333; /* 文字颜色统一，或按状态动态设置 */
}

.status-pending .status-bg {
  background-color: #e6f7ff;
}
.status-pending .status-text {
  color: #1890ff;
}

.status-active .status-bg {
  background-color: #f6ffed;
}
.status-active .status-text {
  color: #52c41a;
}

.status-ended .status-bg {
  background-color: #fff2f0;
}
.status-ended .status-text {
  color: #f5222d;
}

