.activity-meta {
  margin-bottom: 20rpx;
}

.activity-time {
  display: block;
  line-height: 1.5;  /* 控制行间距 */
  font-size: 24rpx;   /* 与图片字号一致 */
  color: #333;       /* 文字颜色 */
  text-align: left;  /* 左对齐 */
}

.activity-time2 {
  padding-left: 20px; /* 左侧添加10px的空白 */
  display: block;
  line-height: 1.5;  /* 控制行间距 */
  font-size: 24rpx;   /* 与图片字号一致 */
  color: #333;       /* 文字颜色 */
  text-align: left;  /* 左对齐 */
}

/* 保持图片中的极简风格 */
.location-wrapper {
  max-width: 100%;
  overflow: hidden;
}
.activity-location {
  font-size: 24rpx;
  display: inline-block;
  max-width: 100%;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  vertical-align: middle;
}


.activity-footer {
  display: flex;
  justify-content: space-between;
  margin-top: auto;
}

.activity-price {
  color: #f56c6c;
  font-weight: bold;
  font-size: 32rpx;
}

.activity-participants {
  color: #999;
  font-size: 24rpx;
}

/* 加载更多提示 */
.load-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.load-more loading {
  margin-bottom: 16rpx;
}

.no-more {
  color: #ccc;
}



/* 按钮容器 */
.join-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  height: 55rpx;
  width: 200rpx;
  margin-left: 10rpx;
  margin-top: 5rpx;
}

/* 按钮背景 */
.btn-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  background-color: #14746f;
  z-index: 1;
  transition: all 0.3s;
}

/* 按钮文字 */
.btn-text {
  position: relative;
  z-index: 2;
  font-size: 28rpx;
  color: #fff;
}

/* 禁用状态 */
.join-btn.disabled .btn-bg {
  background-color: #d9d9d9;
}

.join-btn.disabled .btn-text {
  color: #999;
}

/* 点击效果 */
.join-btn:active .btn-bg {
  transform: scale(0.98);
  opacity: 0.8;
}

.join-btn.disabled:active .btn-bg {
  transform: none;
}