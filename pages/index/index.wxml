<!--pages/index/index.wxml-->
<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <icon type="search" size="16" class="search-icon" />
    <input placeholder="搜索活动名称" placeholder-class="placeholder-style" confirm-type="search" />
    <!-- 右侧刷新图标（图片替代文字） -->
    <image src="/images/refresh.png" class="refresh-icon" mode="widthFix" bindtap="refreshData" />
  </view>

  <!-- 骨架屏加载状态 -->
  <view wx:if="{{isLoading && page === 1}}" class="loading-container">
    <view class="skeleton-item" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton-image"></view>
      <view class="skeleton-content">
        <view class="skeleton-title"></view>
        <view class="skeleton-text"></view>
        <view class="skeleton-text short"></view>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <!-- <view wx:if="{{loadError}}" class="error-container">
    <image src="/images/error.png" mode="aspectFit" class="error-image" />
    <text class="error-text">加载失败，请重试</text>
    <button size="mini" type="primary" bindtap="onRetry" class="retry-btn">重新加载</button>
  </view> -->

  <!-- 空状态 -->
  <view wx:if="{{!isLoading && activities.length === 0 && !loadError}}" class="empty-container">
    <text class="empty-text">暂无活动数据</text>
  </view>

  <!-- 活动列表 -->
  <scroll-view wx:if="{{activities.length > 0}}" scroll-y class="activity-scroll" bindscrolltolower="onReachBottom" refresher-enabled="{{false}}" bindrefresherrefresh="refreshData" refresher-triggered="{{isRefreshing}}">
    <view class="activity-list">
      <view class="activity-card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}">
        <image class="activity-image" src="{{item.cover_image || '/images/avatar.webp'}}" mode="aspectFill" />
        <view class="activity-content">
          <view class="activity-header">
            <text class="activity-title">{{item.title}}</text>


            <view class="activity-status status-{{item.status === '进行中' ? 'active' : item.status === '已结束' ? 'ended' : 'pending'}}">
              <!-- 背景层 -->
              <view class="status-bg"></view>
              <!-- 文字层 -->
              <text class="status-text">{{item.status}}</text>
            </view>

          </view>
          <view class="activity-meta">
            <text class="activity-time">⏱ {{item.formatted_start_time}}</text>
            <text class="activity-time2">-{{item.formatted_end_time}}</text>
            <view class="location-wrapper">
              <text class="activity-location">📍 {{item.location_name || '地点待定'}}</text>
            </view>
          </view>
          <!-- 新增参加按钮 -->
          <view class="join-btn {{item.status !== '进行中' ? 'disabled' : ''}}" bindtap="handleJoin" data-item="{{item}}">
            <view class="btn-bg"></view>
            <text class="btn-text">查看详情</text>
          </view>


        </view>
      </view>

      <!-- 加载更多提示 -->
      <!-- <view wx:if="{{isLoading && page > 1}}" class="load-more">
        <loading type="circles" color="#6190E8" />
        <text>正在加载更多...</text>
      </view> -->

      <view wx:if="{{!hasMore && !isLoading}}" class="no-more">
        <text>已经到底了~</text>
      </view>

    </view>
  </scroll-view>
</view>