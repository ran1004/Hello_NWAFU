<!-- create.wxml -->
<view class="container">
  <form bindsubmit="formSubmit">
    <view class="form-item">
      <text>活动标题：</text>
      <input name="title" placeholder="请输入标题" />
    </view>

    <view class="form-item">
      <text>活动内容：</text>
      <textarea name="content" placeholder="请输入详细内容" auto-height />
    </view>

    <!-- <view class="form-item">
      <text>活动时间：</text>
      <picker name="datetime" mode="multiSelector" 
              fields="second" 
              bindchange="bindTimeChange"
              value="{{timeIndex}}"
              range="{{timeRange}}">
        <input placeholder="请选择日期时间" disabled value="{{formattedTime}}" />
      </picker>
    </view> -->

    <!-- 调整后的时间选择区域 -->
    <view class="form-item">
  <text>活动时间：</text>
  <view class="time-picker">
    <!-- 日期选择 -->
    <picker 
      mode="date" 
      value="{{selectedDate}}"
      start="{{startDate}}"
      end="{{endDate}}"
      bindchange="bindDateChange"
    >
      <text class="placeholder">{{dateStr || "选择日期"}}</text>
    </picker>
    
    <!-- 时间选择 -->
    <picker 
      mode="time" 
      value="{{selectedTime}}"
      bindchange="bindTimeChange"
    >
      <text class="placeholder">{{timeStr || "选择时间"}}</text>
    </picker>
  </view>
</view>
    <button form-type="submit" type="primary" class="submit-btn">发布活动</button>
  </form>
</view>