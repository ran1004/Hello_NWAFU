/* create.wxss 最终版 */
/* 🌈 页面基础设置 */
page {
  background: #f5f5f5; 
  min-height: 100vh;
  padding: 0 20rpx;
}

/* 🌟 容器边界强化 */
.container {
  padding: 20rpx 0;
  box-sizing: border-box; /* 新增盒子模型 */
}

/* 🌈 表单项重构 */
.form-item {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 28rpx; /* 统一内边距 */
  margin: 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  overflow: hidden; /* 新增溢出控制 */
}

.form-label {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 28rpx;
}

/* 🌟 输入域溢出修复 */
.form-input, .form-textarea {
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 32rpx;
  background: #fafafa;
  box-sizing: border-box; /* 新增盒子模型 */
  max-width: 100%; /* 防止溢出 */
}

.form-textarea {
  min-height: 240rpx;
  max-height: 400rpx; /* 限制最大高度 */
  line-height: 1.6;
  overflow-y: auto; /* 新增滚动条 */
}

/* create.wxss 时间选择器修改部分 */
/* 🌟 全新时间容器样式 */
.time-container {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

/* 🌟 时间项纵向布局 */
.time-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  margin: 0 -8rpx; /* 解决溢出问题 */
}

.time-label {
  font-size: 30rpx;
  color: #333;
  min-width: 120rpx; /* 固定标签宽度 */
}

/* 🌟 值容器优化 */
.time-value-box {
  flex: 1;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-left: 16rpx; /* 增加左边距 */
}

.time-value {
  font-size: 30rpx;
  color: #333;
  display: block;
  overflow: visible; /* 确保文字显示完整 */
}

/* 🌟 新增分隔线 */
.time-divider {
  height: 2rpx;
  background: #eee;
  margin: 20rpx 0;
}

/* 🌈 按钮强化 */
.submit-btn {
  margin-top: 60rpx;
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #07c160;
  color: #fff;
  font-size: 36rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.2);
  transition: all 0.2s;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.placeholder {
  color: #999;
  font-size: 30rpx;
}