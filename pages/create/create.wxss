/* pages/activity/create.wxss */
.create-page {
  background-color: #f7f7f7;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  padding: 30rpx;
  background-color: #fff;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}



.input-container {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-weight: bold;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
}

/* 修改输入框基础样式 */
.fixed-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 88rpx; /* 确保文字垂直居中 */
  background-color: #fff;
}

/* 文本域特殊样式 */
.fixed-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.5;
  background-color: #fff;
}

.auto-expand-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.5;
  background-color: #fff;
  display: block;
}



.placeholder {
  color: #ccc;
}


/* WXSS */
.time-group {
  margin-bottom: 40rpx;
}

.time-item {
  margin-bottom: 40rpx;
}

.time-item .label {
  font-weight: bold;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

/* 新增：横向排列的时间选择行 */
.time-row {
  display: flex;
  gap: 20rpx; /* 两个选择器间距 */
}

.time-row > picker {
  flex: 1;
}

/* 保持图片中的灰色选择框样式 */
.time-picker {
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fafafa;
  text-align: center;
}


.upload-section {
  margin-bottom: 40rpx;
}


.delete-btn {
  position: absolute;
  top: -12rpx;      /* 增大向上偏移 */
  right: -12rpx;    /* 增大向右偏移 */
  width: 40rpx;     /* 增大尺寸（原40rpx） */
  height: 40rpx;
  background: black;
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;  /* 增大"×"符号 */
  z-index: 9999;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2); /* 阴影更明显 */
  border: 2rpx solid white; /* 添加白色边框，避免和背景色融合 */
}


.section-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.upload-area {
  position: relative; /* 新增 */
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-placeholder image {
  width: 60rpx;
  margin-bottom: 10rpx;
}

.upload-placeholder text {
  font-size: 24rpx;
  color: #999;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.image-item {
  width: calc(33.33% - 20rpx);
  margin: 10rpx;
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.add-btn {
  border: 2rpx dashed #ddd;
  display: flex;
  justify-content: center;
  align-items: center;
}

.add-btn image {
  width: 50rpx;
  opacity: 0.5;
}

.delete-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx !important;
  height: 36rpx !important;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  padding: 8rpx;
}

.temp-image {
  width: 100%;
  height: 100%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}


.submit-btn {
  background-color: #07C160;
  color: white;
  border-radius: 50rpx;
  margin-top: 60rpx;
  font-size: 32rpx;
  height: 90rpx;
  line-height: 90rpx;
}

.submit-btn-hover {
  opacity: 0.9;
}