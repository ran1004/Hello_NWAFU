<!-- WXML -->
<view class="complex-container">
  <!-- 文本内容 -->
  <text class="content-text">{{user_name}}</text>

  <!-- 右上角头像 -->
  <image style="position: absolute; left: 562rpx; top: 29rpx" src="{{avatarUrl}}" class="corner-avatar" mode="aspectFill" bind:tap="handleAvatarTap" />

  <!-- 左下角按钮 -->
  <button class="corner-button" bind:tap="goToProfile" hover-class="button-hover">
    <text>编辑个人资料</text>
  </button>




</view>
<view class="complex-container" style="margin-top: 30rpx;">
  <!-- data_activity_id 从当前活动界面获取 -->
  <button style="margin: 10rpx;" plain
  data-actid="1" bindtap="get_single_csv" hover-class="button-hover">导出当前活动打卡情况</button>

  <button style="margin: 10rpx;" plain 
  data-actid="1" bindtap="get_acclass1_csv" hover-class="button-hover">导出所有跳操打卡情况</button>
  
  <navigator url="/pages/clock_calendar/clock_calendar" style="margin: 10rpx;"> 
  <button  plain bindtap="showPopup"  hover-class="button-hover">查看个人打卡情况</button>
  </navigator>
</view>
