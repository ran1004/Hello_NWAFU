/* pages/info/profile.wxss */

/*调整部分*/
/* 新增页面背景渐变 */
page {
    background: linear-gradient(180deg, #f0f9f0 0%, #f8f8f8 100%);
    min-height: 100vh;
}
/* 内容区域优化 */
.content {
    background: #fff;
    border-radius: 24rpx;
    margin: 20rpx 30rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}
/* 只读输入框样式优化 */
.readonly {
    background: #fafafa !important; 
    color: #666 !important;      
    border-radius: 12rpx;
    padding: 16rpx 20rpx !important;
    border: 2rpx solid #eee !important; 
    cursor: not-allowed;
}
/* 占位符颜色统一 */
.readonly .placeholder {
    color: #bbb !important;      
}
/* 输入框聚焦优化 */
.input:focus {
    background: #f5fff5; 
    border-radius: 12rpx;
    border: 2rpx solid #07c160 !important;
}

/* 导航栏样式 */
/* 导航栏容器 */
.nav-bar {
    position: relative;
    height: 100rpx;
    background: #07c160;
    padding: 0 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.1);
  }
  
  /* 左侧文本定位 */
  .nav-text {
    position: absolute;
    left: 30rpx;
    top: 50%;
    transform: translateY(-50%);
    color: #fff;
    font-size: 32rpx;
    line-height: 1.5;
    text-align: left;
  }
  
  /* 右侧按钮定位 */
  .save-btn {
    position: absolute;
    right: 5rpx;
    top: 50%;
    transform: translateY(-50%);
    color: #fff !important;
    font-size: 32rpx;
    padding: 8rpx 40rpx;
    background: transparent;
    border-radius: 30rpx;
    line-height: 1.5;
    box-shadow: none;
    text-align: right;
  }
  
  /* 去除微信按钮默认样式 */
  button::after {
    border: none !important;
  }

/* 头像区域 */
/* 新增容器样式 */
.avatar-container {
    width: 100%;
    display: flex;
    justify-content: center; /* 水平居中 */
    padding: 40rpx 0; /* 垂直间距 */
    transform: translateZ(0); /* 硬件加速优化 */
    will-change: transform;   /* 预声明动画属性 */
  }
  
  /* 头像包裹层 */
  .avatar-wrapper {
    position: relative;
    width: 200rpx;
    height: 200rpx;
    margin-left: -20rpx; /* 根据截图视觉补偿 */
  }
  
  /* 头像样式保持原状 */
  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4rpx solid #fff;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  }
  /* 添加点击反馈效果 */
  .avatar-container:active {
    opacity: 0.8;
    transform: scale(0.98);
    transition: all 0.2s;
  }

/* 信息列表 */
.info-list {
    background: #fff;
    padding: 20rpx 0;
}

.info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* padding: 30rpx 0; */
    border-bottom: 1rpx solid #eee;
    padding: 32rpx 30rpx; 
    border-bottom: 2rpx solid #f0f0f0; 
}

.label {
    color: #666;
    font-size: 30rpx;
}

.value {
    color: #333;
    font-size: 32rpx;
    max-width: 400rpx;
}

/* 输入框通用样式 */
.input {
    flex: 1;
    text-align: right;
    color: #333;
    font-size: 35rpx;
    padding: 10rpx 20rpx;
    transition: all 0.3s ease;
  }
  
  /* 聚焦状态 */
  .input:focus {
    border-color: #07c160;
  }
  
  /* 学号数字输入优化 */
  input[type="number"] {
    font-family: monospace;
  }
  
  /* 占位符样式 */
  .placeholder {
    color: #999;
  }