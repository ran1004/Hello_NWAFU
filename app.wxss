/**app.wxss**/
.container {
  height: 100%; /* 设置容器高度为100%，占满整个屏幕 */
  display: flex; /* 使用弹性布局 */
  flex-direction: column; /* 子元素按列排列 */
  align-items: center; /* 水平居中对齐 */
  justify-content: space-between; /* 子元素在主轴上两端对齐，间距均匀分布 */
  /*padding: 200rpx 0;*/ /* 被注释的上下内边距，可能是之前的设计 */
  box-sizing: border-box; /* 确保宽度和高度包含内边距和边框 */
  background: #F0F4F3; /* 设置背景颜色 */
}

.container.withtab{
  margin: 105rpx 0 0 0; /* 当存在顶部标签栏时，设置容器的上外边距 */
  /*top: 105rpx;*/ /* 被注释的顶部偏移量 */
}
.flex-wrp{
  display: flex; /* 定义一个弹性布局容器 */
}
.flex-tab{
  flex-flow: row nowrap; /* 子元素水平排列，不换行 */
  justify-content: space-around; /* 子元素间距均匀分布 */
  align-items: stretch; /* 子元素高度拉伸填满容器 */
}
.flex-item{
  flex-grow: 1; /* 子元素按比例分配多余空间 */
  text-align: center; /* 文本居中对齐 */
}
.top-tab{
  width: 750rpx; /* 定义顶部标签栏的宽度 */
  height: 100rpx; /* 定义顶部标签栏的高度 */
  background: #07c160; /* 设置背景颜色 */
  color: #8CCEFD; /* 设置文字颜色 */
  font-size: 28rpx; /* 设置字体大小 */
  line-height: 100rpx; /* 设置行高，使文字垂直居中 */
  box-shadow: 0 2px 2px #bebebe; /* 添加阴影效果 */
  margin: 0 0 8rpx 0; /* 设置外边距 */
  position: fixed; /* 固定定位，使标签栏始终在顶部 */
  top: 0; /* 距离顶部的距离 */
  z-index: 9999; /* 设置层级，确保标签栏在最上层 */
}
.toptab.active{
  color: #ffffff; /* 激活状态下的文字颜色 */
  border-bottom: solid 2px #ffffff; /* 激活状态下的下边框样式 */
}
.container{
  padding: 0; /* 容器内边距为0 */
  font-size: 14rpx; /* 设置字体大小 */
  color: #000; /* 设置文字颜色 */
}