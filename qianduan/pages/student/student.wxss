/* pages/student/student.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #666;
}
.loading image {
  width: 60rpx;
  height: 60rpx;
  margin-top: 20rpx;
}

/* 错误提示 */
.error {
  text-align: center;
  padding: 40rpx;
  color: #e64340;
}
.error button {
  margin-top: 30rpx;
  width: 200rpx;
}

/* 活动卡片 */
.activity-card {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.time {
  font-size: 26rpx;
  color: #666;
}

.content .label {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin: 15rpx 0;
}

.publisher {
  color: #007AFF;
  font-size: 28rpx;
}

.detail {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* pages/student/student.wxss */
/* WebSocket状态提示 */
.ws-status {
  background: #fffbe6;
  padding: 16rpx;
  margin: 20rpx;
  border-radius: 8rpx;
  border: 1px solid #ffe58f;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 新活动角标 */
.new-badge {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  background: #ff4d4f;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}