/**app.wxss**/
.container {
  height: 100%; /* 设置容器高度为100%，占满整个屏幕 */
  display: flex; /* 使用弹性布局 */
  flex-direction: column; /* 子元素按列排列 */
  align-items: center; /* 水平居中对齐 */
  justify-content: space-between; /* 子元素在主轴上两端对齐，间距均匀分布 */
  /*padding: 200rpx 0;*/ /* 被注释的上下内边距，可能是之前的设计 */
  box-sizing: border-box; /* 确保宽度和高度包含内边距和边框 */
  background: #F0F4F3; /* 设置背景颜色 */
}

.container.withtab{
  margin: 105rpx 0 0 0; /* 当存在顶部标签栏时，设置容器的上外边距 */
  /*top: 105rpx;*/ /* 被注释的顶部偏移量 */
}
.flex-wrp{
  display: flex; /* 定义一个弹性布局容器 */
}
.flex-tab{
  flex-flow: row nowrap; /* 子元素水平排列，不换行 */
  justify-content: space-around; /* 子元素间距均匀分布 */
  align-items: stretch; /* 子元素高度拉伸填满容器 */
}
.flex-item{
  flex-grow: 1; /* 子元素按比例分配多余空间 */
  text-align: center; /* 文本居中对齐 */
}
.top-tab{
  width: 750rpx; /* 定义顶部标签栏的宽度 */
  height: 100rpx; /* 定义顶部标签栏的高度 */
  background: #07c160; /* 设置背景颜色 */
  color: #8CCEFD; /* 设置文字颜色 */
  font-size: 28rpx; /* 设置字体大小 */
  line-height: 100rpx; /* 设置行高，使文字垂直居中 */
  box-shadow: 0 2px 2px #bebebe; /* 添加阴影效果 */
  margin: 0 0 8rpx 0; /* 设置外边距 */
  position: fixed; /* 固定定位，使标签栏始终在顶部 */
  top: 0; /* 距离顶部的距离 */
  z-index: 9999; /* 设置层级，确保标签栏在最上层 */
}
.toptab.active{
  color: #ffffff; /* 激活状态下的文字颜色 */
  border-bottom: solid 2px #ffffff; /* 激活状态下的下边框样式 */
}
.container{
  padding: 0; /* 容器内边距为0 */
  font-size: 14rpx; /* 设置字体大小 */
  color: #000; /* 设置文字颜色 */
}
.container .feed-item{
  width: 690rpx; /* 单个信息项的宽度 */
  padding: 30rpx 30rpx 20rpx; /* 设置内边距 */
  margin: 7rpx 0 6rpx 0; /* 设置外边距 */
  background: #ffffff; /* 背景颜色 */
  border-top: 1px solid #eee; /* 上边框样式 */
  border-bottom: 1px solid #eee; /* 下边框样式 */
  box-shadow: 0 2px 5px #eeeeee; /* 阴影效果 */
}
.container .feed-item .feed-source{
  width: 690rpx; /* 信息来源部分的宽度 */
  left: 0; /* 距离左侧的距离 */
  height: 50rpx; /* 高度 */
}
.container .feed-item .feed-source .avatar{
  position: relative; /* 相对定位 */
  display: inline-block; /* 使元素以内联块的形式显示 */
}
.container .feed-item .feed-source a{
  display: inline-block; /* 使链接以内联块的形式显示 */
  height: 40rpx; /* 高度 */
}
.container .feed-item .feed-source .avatar image{
  /*position: absolute;*/ /* 被注释的绝对定位 */
  display: inline-block; /* 以内联块形式显示 */
  width: 45rpx; /* 图片宽度 */
  height: 45rpx; /* 图片高度 */
  border-radius: 45rpx; /* 圆角，使图片呈圆形 */
  top: 10rpx; /* 距离顶部的距离 */
  vertical-align: middle; /* 垂直居中对齐 */
}
.container .feed-item .feed-source text{
  /*position: absolute;*/ /* 被注释的绝对定位 */
  display: inline-block; /* 以内联块形式显示 */
  height: 40rpx; /* 高度 */
  line-height: 40rpx; /* 行高，使文字垂直居中 */
  vertical-align: middle; /* 垂直居中对齐 */
  margin: 0 0 0 15rpx; /* 设置左边距 */
  color: #a0acac; /* 文字颜色 */
  font-size: 26rpx; /* 字体大小 */
}
.container .feed-item .feed-source .item-more{
  display: inline-block; /* 以内联块形式显示 */
  width: 40rpx; /* 宽度 */
  height: 45rpx; /* 高度 */
  float:right; /* 浮动到右侧 */
}
.container .feed-item .feed-content{
  padding: 10rpx 0 0 0; /* 内容区域的上内边距 */
}
.container .feed-item .feed-content .question text{
  font-size: 28rpx; /* 问题文字的字体大小 */
  font-weight: 600; /* 字体加粗 */
  line-height: 40rpx; /* 行高 */
  letter-spacing: 5rpx; /* 文字间距 */
}
.container .feed-item .feed-content .answer-body{
  padding: 10rpx 0 0 0; /* 回答内容的上内边距 */
  /*height: 10rpx;*/ /* 被注释的高度 */
  font-size: 24rpx; /* 字体大小 */
  line-height: 28rpx; /* 行高 */
  color: #5b5b5b; /* 文字颜色 */
}
.container .feed-item .feed-content .answer-actions{
  width: 690rpx; /* 操作区域的宽度 */
  padding: 10rpx 0  0; /* 上内边距 */
  color: #a0acac; /* 文字颜色 */
}
.container .feed-item .feed-content .answer-actions view{
  display: inline-block; /* 以内联块形式显示 */
  vertical-align: text-bottom; /* 垂直对齐方式 */
  padding: 0 10rpx 0 0; /* 右内边距 */
  font-size: 24rpx; /* 字体大小 */
}
.container .feed-item .feed-content .answer-actions .dot ::after{
  content: "•"; /* 在元素后添加一个圆点符号 */
}